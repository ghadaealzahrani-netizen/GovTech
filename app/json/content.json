  "welcome": {
    "page_mode": "single_page",
    "modules": [{
        "module": "image",
        "file": "cover.png",
        "margin": false,
        "size": false,
        "bgcolor": "transparent",
        "bgmode": "fill",
        "alt": "GovTech"
      },
      {
        "module": "double_lang",
        "margin": "lg",
        "options": [{
            "lg": "en",
            "label": "english",
            "url": "${root}?lang=en"
          },
          {
            "lg": "ar",
            "label": "العربية",
            "url": "${root}?lang=ar"
          }
        ],
        "size": "md"
      },
      {
        "module": "button",
        "margin": "lg",
        "label": "global_success_stories",
        "size": "lg",
        "mode": "internal",
        "dest": "success_stories_global",
        "icon": false
      },
      {
        "module": "button",
        "margin": "md",
        "label": "local_success_stories",
        "size": "lg",
        "mode": "internal",
        "dest": "success_stories_local",
        "icon": false
      },
      {
        "module": "text",
        "margin": "xl",
        "src": "description",
        "section": false,
        "auto_links": false
      }
    ]
  },

  "about": {
    "page_mode": "single_page",
    "modules": [{
        "module": "section_title",
        "margin": false,
        "tx": "credits"
      },

      {
        "module": "credits",
        "margin": "md",
        "list": [{
            "name": {
              "en": "Eng. Abdulmohsen Almadi",
              "ar": "م. عبدالمحسن الماضي"
            },
            "role": "dba_ceo"
          },
          {
            "name": {
              "en": "Eng. Moath Alzahrani",
              "ar": "م. معاذ الزهراني"
            },
            "role": "dba_director"
          },
          {
            "name": {
              "en": "Eng. Hanan Alsalamah",
              "ar": "م. حنان السلامة"
            },
            "role": "data_scientist"
          },
          {
            "name": {
              "en": "Eng. Khalid Almuraee",
              "ar": "م. خالد المورعي"
            },
            "role": "et_and_bm"
          }
        ]
      },

      {
        "module": "players",
        "margin": "xxl",
        "list": [{
          "name": {
            "en": "Digital Government Authority",
            "ar": "هيئة الحكومة الرقمية"
          },
          "description": {
            "en": [
              "Digital Government Authority (DGA) is concerned with everything related to digital government in Saudi Arabia. It has been established to guide the digital transformation journey of the government entities in the Kingdom to help them in delivering highly efficient digital services, and adoption and enablement of emerging technologies. DGA aims to achieve these objectives by providing strategic direction, achieving integration in the field of digital government among all government agencies, setting standards to regulate the sector and running enablement programs for required capacity and capabilities."
            ],
            "ar": [
              "تهتم هيئة الحكومة الرقمية بكل ما يتعلق بالحكومة الرقمية في المملكة. وقد تم تأسيسها لمساعدة الجهات الحكومية في رحلة التحول الرقمي وتمكينها من تقديم خدمات رقمية عالية الكفاءة، وتوفير الدعم لتبني وتمكين التقنيات الناشئة. تهدف الهيئة إلى تحقيق هذه الأهداف من خلال توضيح التوجهات الاستراتيجية، وتحقيق التكامل في  الحكومة الرقمية بين جميع الجهات، وتحديد المعايير لتنظيم القطاع وتشغيل برامج التمكين للمهارات والقدرات اللازمة."
            ]
          },
          "link": {
            "label": "dga.gov.sa",
            "url": {
              "en": "https://dga.gov.sa/en/",
              "ar": "https://dga.gov.sa/"
            }
          }
        }]
      },
      {
        "module": "about_logos",
        "margin": "lg"
      }
    ]
  },

  "entity": {
    "page_mode": "single_page",
